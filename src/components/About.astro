---
import SectionLabel from './SectionLabel.astro';
import LogoMark from './LogoMark.astro';
import Deco from './Deco.astro';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].about;

const tone: Record<string, string> = {
  serif: 'font-serif italic text-bone text-[1.08em] tracking-[-0.01em]',
  orange: 'text-orange',
  blue: 'text-blue-light',
};
---

<section id="about" class="wrap py-24 md:py-36">
  <SectionLabel index="01" label={t.label} />

  <!-- Declaración principal: las palabras se iluminan con el scroll -->
  <p data-scrub-words class="mt-10 max-w-6xl text-[clamp(1.9rem,4.6vw,4.25rem)] leading-[1.04] font-semibold tracking-[-0.035em] md:mt-14">
    {
      t.statement.map((s) => (
        <span class={s.c ? tone[s.c] : ''}>{s.t}</span>
      ))
    }
  </p>

  <div class="mt-16 grid gap-10 md:mt-24 md:grid-cols-12 md:gap-8">
    <!-- Foto -->
    <figure data-reveal class="relative md:col-span-5 lg:col-span-4">
      <!-- Bloques de marca (eco del hero) -->
      <span aria-hidden="true" class="absolute -top-5 -right-5 h-24 w-24 border-[3px] border-orange md:-top-6 md:-right-6 md:h-28 md:w-28"></span>
      <span aria-hidden="true" class="absolute -top-5 -left-5 z-10 grid h-16 w-16 place-items-center bg-blue text-ink md:h-20 md:w-20">
        <Deco name="globe" class="w-[45%]" />
      </span>
      <div class="grain relative aspect-[4/5] overflow-hidden rounded-3xl border border-line bg-coal">
        <div class="grid-lines absolute inset-0 opacity-60"></div>
        <div class="absolute -bottom-1/4 left-1/2 aspect-square w-[95%] -translate-x-1/2 rounded-full bg-linear-to-tr from-blue to-orange opacity-80 blur-2xl"></div>
        <img
          src="/cris-image.webp"
          alt="Cristian Ortiz"
          width="538"
          height="693"
          loading="lazy"
          data-parallax-img
          class="absolute inset-x-0 bottom-0 mx-auto h-[96%] w-auto object-contain object-bottom"
        />
        <LogoMark class="absolute top-5 left-5 h-5 w-auto text-bone/80" />
        <span class="mono-label absolute top-5 right-5 text-bone/70">CO — 2026</span>
      </div>
      <figcaption class="mt-4 flex items-center justify-between mono-label text-muted">
        <span>Cali, Colombia</span>
        <span>{t.localTime} · <span data-clock class="text-bone">--:--</span> (UTC−5)</span>
      </figcaption>
    </figure>

    <!-- Bio + stats -->
    <div class="flex flex-col justify-between gap-12 md:col-span-7 md:col-start-6 lg:col-span-7 lg:col-start-6">
      <div class="max-w-xl space-y-5 text-lg leading-relaxed text-bone/75">
        {t.bio.map((p) => <p data-reveal>{p}</p>)}
      </div>

      <dl class="grid grid-cols-2 border-t border-line">
        {
          t.stats.map((s, i) => (
            <div
              data-reveal
              class:list={[
                'border-b border-line py-6 pr-4',
                i % 2 === 1 && 'border-l pl-6',
              ]}
            >
              <dt class="sr-only">{s.label}</dt>
              <dd class="display text-[clamp(3rem,7vw,5.5rem)] text-bone">
                <span data-count={s.value}>{s.value}</span>
                <span class="text-orange">{s.suffix}</span>
              </dd>
              <dd aria-hidden="true" class="mt-3 max-w-[16rem] text-sm text-muted">
                {s.label}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<script>
  // Reloj en vivo con la hora de Cali
  const el = document.querySelector<HTMLElement>('[data-clock]');
  if (el) {
    const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'America/Bogota' });
    const tick = () => (el.textContent = fmt.format(new Date()));
    tick();
    setInterval(tick, 15000);
  }
</script>
