---
import { ui, contact, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].contactSection;
---

<section id="contact" class="relative overflow-hidden pt-24 md:pt-36">
  <div class="wrap">
    <p data-reveal class="mono-label flex items-center gap-3 text-muted">
      <span class="flex items-center gap-1.5 text-bone"><span class="block h-2.5 w-2.5 bg-orange"></span><span class="block h-2.5 w-2.5 bg-blue"></span><span class="ml-1">06</span></span><span class="h-px w-8 bg-line"></span>{t.label}
    </p>

    <h2 class="relative mt-10 text-center display text-[clamp(2.25rem,6vw,6.5rem)]">
      <span class="hero-line block overflow-hidden pb-[0.12em] -mb-[0.12em]" data-line-reveal><span class="block">{t.line1}</span></span>
      <span class="hero-line block overflow-hidden pb-[0.12em] -mb-[0.12em]" data-line-reveal
        ><span class="block"
          ><span class="text-outline">{t.line2}</span>{' '}<span class="font-serif font-normal tracking-[-0.03em] text-orange italic">{t.line3}</span></span
        ></span
      >
    </h2>

    <div class="mt-14 grid gap-12 md:mt-20 md:grid-cols-12">
      <p data-reveal class="max-w-md text-lg leading-relaxed text-bone/70 md:col-span-5">{t.text}</p>

      <div data-reveal class="md:col-span-7 md:justify-self-end">
        <div class="flex flex-wrap items-center gap-3">
          <a
            href={`mailto:${contact.email}`}
            class="link-underline text-[clamp(1.35rem,3.2vw,2.75rem)] font-semibold tracking-tight break-all hover:text-orange"
          >
            {contact.email}
          </a>
          <button
            type="button"
            id="copy-email"
            data-email={contact.email}
            data-copied={t.copied}
            data-copy={t.copy}
            class="mono-label rounded-full border border-line px-3 py-2 transition-colors hover:border-orange hover:text-orange"
          >
            {t.copy}
          </button>
        </div>
        <div class="mt-6 flex flex-wrap gap-2">
          <a href={contact.linkedin} target="_blank" rel="noopener" class="btn btn-ghost">
            LinkedIn
            <span class="btn-icon"
              ><svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"
                ><path d="M2 12 12 2m0 0H5m7 0v7" stroke="currentColor" stroke-width="1.6"></path></svg
              ></span
            >
          </a>
          <a href={contact.behance} target="_blank" rel="noopener" class="btn btn-ghost">
            Behance
            <span class="btn-icon"
              ><svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"
                ><path d="M2 12 12 2m0 0H5m7 0v7" stroke="currentColor" stroke-width="1.6"></path></svg
              ></span
            >
          </a>
          <a href={contact.cv} download class="btn btn-primary">
            CV
            <span class="btn-icon"
              ><svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"
                ><path d="M7 1v12m0 0 5-5m-5 5L2 8" stroke="currentColor" stroke-width="1.6"></path></svg
              ></span
            >
          </a>
        </div>
      </div>
  </div>
  </div>
</section>

<script>
  const btn = document.getElementById('copy-email');
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.email || '');
      btn.textContent = btn.dataset.copied || 'Copied!';
      setTimeout(() => (btn.textContent = btn.dataset.copy || 'Copy'), 2000);
    } catch {
      window.location.href = `mailto:${btn.dataset.email}`;
    }
  });
</script>
