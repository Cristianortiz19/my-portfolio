---
import SectionLabel from './SectionLabel.astro';
import { expertise } from '../data/content';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].expertise;

const color: Record<string, string> = {
  orange: 'text-orange',
  blue: 'text-blue-light',
  bone: 'text-bone',
  outline: 'text-outline text-bone',
};
---

<section id="expertise" class="wrap py-24 md:py-32">
  <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <SectionLabel index="02" label={t.label} />
    <h2 data-split class="max-w-md text-3xl font-semibold tracking-[-0.03em] md:text-right md:text-4xl">{t.title}</h2>
  </div>

  <ul class="mt-12 border-t border-line md:mt-16">
    {
      expertise.map((e, i) => (
        <li data-reveal class="group relative border-b border-line">
          <div class="grid gap-5 py-8 md:grid-cols-12 md:items-center md:gap-8 md:py-10">
            <div class="flex items-baseline gap-4 md:col-span-5">
              <span class="mono-label text-muted">0{i + 1}</span>
              <h3
                class:list={[
                  'display text-[clamp(2.75rem,6.5vw,5.75rem)] transition-transform duration-700 ease-expo group-hover:translate-x-3',
                  color[e.color],
                ]}
                style="letter-spacing: -0.01em"
              >
                {e.title[lang]}
              </h3>
            </div>
            <p class="max-w-sm text-[15px] leading-relaxed text-bone/65 md:col-span-3">{e.text[lang]}</p>
            <ul class="flex flex-wrap gap-2 md:col-span-4 md:justify-end" aria-label="Skills">
              {e.skills.map((s) => (
                <li class="chip transition-colors group-hover:border-white/20">{s}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ul>
</section>
