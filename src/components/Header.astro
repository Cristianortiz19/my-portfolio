---
import LogoMark from './LogoMark.astro';
import { ui, localePath, languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const t = ui[lang];
const home = localePath(lang, '/');

const links = [
  { href: `${home}#work`, label: t.nav.work },
  { href: `${home}#about`, label: t.nav.about },
  { href: `${home}#services`, label: t.nav.services },
  { href: `${home}#contact`, label: t.nav.contact },
];
const langs = Object.keys(languages) as Lang[];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-transform duration-500">
  <div class="wrap flex h-16 items-center justify-between gap-4 md:h-20">
    <!-- Logo -->
    <a href={home} class="group flex items-center gap-2.5" aria-label="Cristian Ortiz — Home">
      <LogoMark class="h-5 w-auto text-orange transition-transform duration-700 ease-expo group-hover:rotate-[-20deg] md:h-6" />
      <span class="text-[15px] font-bold tracking-tight">Cristian Ortiz</span>
    </a>

    <!-- Navegación (pill central) -->
    <nav
      aria-label="Main"
      class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-1 rounded-full border border-line bg-ink/60 p-1 backdrop-blur-md lg:flex"
    >
      {
        links.map((l) => (
          <a
            href={l.href}
            class="rounded-full px-4 py-1.5 text-[13px] font-medium text-bone/70 transition-colors hover:bg-white/8 hover:text-bone"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <!-- Selector de idioma -->
      <div class="flex items-center rounded-full border border-line bg-ink/60 p-1 font-mono text-[11px] backdrop-blur-md">
        {
          langs.map((l) => (
            <a
              href={localePath(l, path)}
              hreflang={l}
              aria-current={l === lang ? 'true' : undefined}
              class:list={[
                'rounded-full px-2.5 py-1 transition-colors',
                l === lang ? 'bg-bone text-ink' : 'text-bone/60 hover:text-bone',
              ]}
            >
              {languages[l]}
            </a>
          ))
        }
      </div>

      <a
        href={`${home}#contact`}
        class="hidden items-center gap-2 rounded-full bg-orange px-4 py-2 text-[13px] font-semibold text-ink transition-colors hover:bg-bone sm:inline-flex"
      >
        {t.nav.cta}
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"
          ><path d="M2 10 10 2M4 2h6v6" stroke="currentColor" stroke-width="1.5"></path></svg
        >
      </a>

      <!-- Botón menú móvil -->
      <button
        id="menu-open"
        type="button"
        class="grid h-9 w-9 place-items-center rounded-full border border-line bg-ink/60 backdrop-blur-md lg:hidden"
        aria-label={t.nav.menu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true">
          <path d="M0 1h16M0 9h16" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Menú móvil a pantalla completa -->
<div
  id="mobile-menu"
  class="pointer-events-none fixed inset-0 z-[60] flex flex-col bg-ink opacity-0 transition-opacity duration-500 lg:hidden"
  aria-hidden="true"
>
  <div class="wrap flex h-16 items-center justify-between">
    <span class="flex items-center gap-2.5">
      <LogoMark class="h-5 w-auto text-orange" />
      <span class="text-[15px] font-bold tracking-tight">Cristian Ortiz</span>
    </span>
    <button
      id="menu-close"
      type="button"
      class="grid h-9 w-9 place-items-center rounded-full border border-line"
      aria-label={t.nav.close}
    >
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="m1 1 10 10M11 1 1 11" stroke="currentColor" stroke-width="1.5"></path>
      </svg>
    </button>
  </div>
  <nav aria-label="Mobile" class="wrap flex flex-1 flex-col justify-center gap-2">
    {
      links.map((l, i) => (
        <a href={l.href} class="mobile-link display flex items-baseline gap-4 py-1 text-[clamp(2.75rem,13vw,5rem)]">
          <span class="mono-label text-orange">0{i + 1}</span>
          {l.label}
        </a>
      ))
    }
  </nav>
  <div class="wrap pb-8 mono-label text-muted">© Cristian Ortiz — Cali, Colombia</div>
</div>

<script>
  const header = document.getElementById('site-header');
  const menu = document.getElementById('mobile-menu');
  const openBtn = document.getElementById('menu-open');
  const closeBtn = document.getElementById('menu-close');

  // Ocultar el header al bajar, mostrarlo al subir
  let lastY = window.scrollY;
  window.addEventListener(
    'scroll',
    () => {
      const y = window.scrollY;
      if (header) header.style.transform = y > lastY && y > 200 ? 'translateY(-110%)' : 'translateY(0)';
      lastY = y;
    },
    { passive: true },
  );

  function setMenu(open: boolean) {
    if (!menu) return;
    menu.classList.toggle('opacity-0', !open);
    menu.classList.toggle('pointer-events-none', !open);
    menu.setAttribute('aria-hidden', String(!open));
    openBtn?.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) closeBtn?.focus();
  }
  openBtn?.addEventListener('click', () => setMenu(true));
  closeBtn?.addEventListener('click', () => setMenu(false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });
</script>
