---
// Hero = "Sobre mí": presentación editorial con declaración grande,
// foto con bloques de marca, CTA y cifras clave.
// Incluye el preloader (nombre que cae letra por letra) en la primera visita.
import LogoMark from './LogoMark.astro';
import Deco from './Deco.astro';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].hero;
const a = ui[lang].about;
const loaderWord = 'Cristian Ortiz';

const tone: Record<string, string> = {
  serif: 'font-serif italic font-normal text-bone tracking-[-0.03em]',
  orange: 'text-orange',
  blue: 'text-blue-light',
};
---

<!-- ───────── Preloader (solo la primera visita de la sesión) ───────── -->
<script is:inline>
  try {
    if (sessionStorage.getItem('co-intro')) document.documentElement.classList.add('intro-done');
  } catch (e) {}
</script>
<div id="loader" aria-hidden="true">
  <p class="loader-word">
    {
      loaderWord.split('').map((ch) => (
        <span class="loader-char-mask">
          <span class="loader-char">{ch === ' ' ? ' ' : ch}</span>
        </span>
      ))
    }
    <span class="loader-mark"><LogoMark class="h-full w-auto" /></span>
  </p>
</div>

<!-- ───────── Hero / About ───────── -->
<section id="about" data-hero class="wrap isolate relative flex min-h-svh flex-col pt-28 pb-10 md:pt-32 md:pb-12">
  <!-- Grid de fondo del hero (de borde a borde, desvanecido hacia abajo) -->
  <div aria-hidden="true" class="grid-lines pointer-events-none absolute top-0 bottom-0 left-1/2 -z-10 w-screen -translate-x-1/2 opacity-70 [mask-image:linear-gradient(to_bottom,#000_40%,transparent_100%)]"></div>
  <div class="grid flex-1 items-center gap-12 md:grid-cols-12 md:gap-8">
    <!-- Texto -->
    <div class="md:col-span-7">

      <h1 data-hero-fade class="text-lg font-semibold tracking-tight md:text-xl">
        Cristian Ortiz <span class="font-normal text-muted">— {t.role}</span>
      </h1>

      <p data-hero-split class="mt-5 text-[clamp(2.05rem,4.3vw,4.5rem)] leading-[1.03] font-semibold tracking-[-0.035em]">
        {t.statement.map((s) => <span class={s.c ? tone[s.c] : ''}>{s.t}</span>)}
      </p>

      <p data-hero-fade class="mt-7 max-w-xl text-base leading-relaxed text-bone/70 md:text-lg">{a.bio[0]}</p>

      <div data-hero-fade class="mt-8 flex flex-wrap items-center gap-3">
        <a href="#contact" class="btn btn-primary">
          {t.cta}
          <span class="btn-icon">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"
              ><path d="M2 12 12 2m0 0H5m7 0v7" stroke="currentColor" stroke-width="1.6"></path></svg
            >
          </span>
        </a>
        <a href="#work" class="btn btn-ghost">
          {t.viewWork}
          <span class="btn-icon">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"
              ><path d="M7 1v12m0 0 5-5m-5 5L2 8" stroke="currentColor" stroke-width="1.6"></path></svg
            >
          </span>
        </a>
        <span class="mono-label ml-1 flex items-center gap-2 text-bone/70"><span class="pulse-dot"></span>{t.available}</span>
      </div>
    </div>

    <!-- Foto -->
    <figure data-hero-fade class="relative mx-auto w-full max-w-[26rem] md:col-span-5 md:max-w-none lg:col-span-4 lg:col-start-9">
      <span aria-hidden="true" class="absolute -top-5 -right-5 h-24 w-24 border-[3px] border-orange md:-top-6 md:-right-6 md:h-28 md:w-28"></span>

      <div class="grain relative aspect-[538/693] max-h-[64svh] overflow-hidden rounded-3xl bg-coal-2">
        <img
          src="/cris-image.webp"
          alt="Cristian Ortiz"
          width="538"
          height="693"
          fetchpriority="high"
          class="absolute bottom-0 left-0 h-full w-auto max-w-none object-contain object-left-bottom"
        />
      </div>

      <!-- Insignia giratoria -->
      <div aria-hidden="true" class="absolute bottom-[20%] -left-12 z-10 hidden h-28 w-28 rounded-full bg-ink md:block lg:h-32 lg:w-32">
        <svg data-badge viewBox="0 0 120 120" class="h-full w-full text-bone/85">
          <defs><path id="badge-circle" d="M60 60m-44 0a44 44 0 1 1 88 0a44 44 0 1 1-88 0"></path></defs>
          <text font-family="JetBrains Mono, monospace" font-size="8.6" letter-spacing="2" fill="currentColor">
            <textPath href="#badge-circle">{t.badge}</textPath>
          </text>
        </svg>
        <span class="absolute inset-0 grid place-items-center text-orange"><Deco name="asterisk" class="w-8" /></span>
      </div>

      <figcaption class="mt-4 flex items-center justify-between mono-label text-muted">
        <span>Cali, Colombia</span>
        <span>{a.localTime} · <span data-clock class="text-bone">--:--</span></span>
      </figcaption>
    </figure>
  </div>

</section>

<style>
  #loader {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
    background: var(--color-ink);
  }
  :global(html:not(.js)) #loader,
  :global(html.reduce) #loader,
  :global(html.intro-done) #loader {
    display: none;
  }
  .loader-word {
    display: flex;
    align-items: center;
    font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    letter-spacing: -0.03em;
    color: var(--color-bone);
  }
  .loader-char-mask {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.1em;
  }
  .loader-char {
    display: inline-block;
    transform: translateY(110%);
  }
  .loader-mark {
    display: inline-block;
    height: 0.62em;
    margin-left: 0.15em;
    margin-top: 0;
    color: var(--color-orange);
    opacity: 0;
  }
</style>

<script>
  // Reloj en vivo con la hora de Cali
  const el = document.querySelector<HTMLElement>('[data-clock]');
  if (el) {
    const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'America/Bogota' });
    const tick = () => (el.textContent = fmt.format(new Date()));
    tick();
    setInterval(tick, 15000);
  }
</script>
