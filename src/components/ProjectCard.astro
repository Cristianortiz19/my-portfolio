---
import ProjectVisual from './ProjectVisual.astro';
import { kindLabel, type Project } from '../data/projects';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
  index: number;
}
const { project: p, lang, index } = Astro.props;
const t = ui[lang].work;
const label = kindLabel[p.kind][lang];
const Tag = p.url ? 'a' : 'article';
const linkProps = p.url ? { href: p.url, target: '_blank', rel: 'noopener' } : {};
const note = p.status === 'nda' ? t.nda : p.status === 'soon' ? t.soon : null;
---

<Tag {...linkProps} data-reveal data-kind={p.kind} class="project-card group block">
  <div class="relative aspect-[4/3] overflow-hidden rounded-2xl border border-line md:rounded-3xl">
    <ProjectVisual project={p} label={label} />

    {
      p.url && (
        <span class="absolute right-4 bottom-4 grid h-12 w-12 scale-75 place-items-center rounded-full bg-orange text-ink opacity-0 transition-all duration-500 ease-expo group-hover:scale-100 group-hover:opacity-100 md:right-5 md:bottom-5">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 12 12 2m0 0H5m7 0v7" stroke="currentColor" stroke-width="1.6" />
          </svg>
        </span>
      )
    }
  </div>

  <div class="mt-5 flex items-start justify-between gap-6">
    <div>
      <h3 class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <span class="text-2xl font-semibold tracking-tight md:text-[1.75rem]">{p.title}</span>
        <span class="mono-label text-muted">/{label}</span>
      </h3>
      <p class="mt-3 max-w-lg text-[15px] leading-relaxed text-bone/65">{p.description[lang]}</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {p.tags.map((tag) => <li class="chip">{tag}</li>)}
      </ul>
    </div>
    <div class="shrink-0 text-right">
      <span class="mono-label text-muted">{String(index + 1).padStart(2, '0')}</span>
      {p.client && <p class="mt-1 hidden max-w-[10rem] text-xs text-muted md:block">{p.client}</p>}
    </div>
  </div>

  {
    note ? (
      <p class="mono-label mt-4 flex items-center gap-2 text-orange">
        <span class="h-1.5 w-1.5 rounded-full bg-orange" />
        {note}
      </p>
    ) : (
      <p class="mono-label mt-4 flex items-center gap-2 text-bone/70 transition-colors group-hover:text-orange">
        <span class="link-underline">{t.viewProject} — Behance ↗</span>
      </p>
    )
  }
</Tag>
