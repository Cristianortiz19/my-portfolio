---
interface Props {
  index: string;
  label: string;
  class?: string;
}
const { index, label, class: className = '' } = Astro.props;
---

<p data-reveal class:list={['mono-label flex items-center gap-3 text-muted', className]}>
  <span class="flex items-center gap-1.5 text-bone">
    <span class="block h-2.5 w-2.5 bg-orange"></span><span class="block h-2.5 w-2.5 bg-blue"></span>
    <span class="ml-1">{index}</span>
  </span>
  <span class="h-px w-8 bg-line"></span>
  {label}
</p>
