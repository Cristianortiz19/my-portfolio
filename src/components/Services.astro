---
import Deco from './Deco.astro';
import { services } from '../data/content';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].services;
---

<section id="services" class="px-2 py-12 md:px-4 md:py-20">
  <div class="grain relative overflow-hidden rounded-[2rem] border border-white/5 bg-linear-to-b from-coal-2 to-ink md:rounded-[3rem]">
    <div class="grid-lines pointer-events-none absolute inset-0 opacity-40 [mask-image:linear-gradient(to_bottom,#000,transparent_60%)]"></div>
    <!-- Detalle: asterisco + bloque azul en la esquina -->
    <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 hidden md:flex">
      <span class="grid h-20 w-20 place-items-center text-orange lg:h-24 lg:w-24"><Deco name="asterisk" class="w-1/2" /></span>
      <span class="h-20 w-20 bg-blue lg:h-24 lg:w-24"></span>
    </div>
    <div class="wrap relative py-20 md:py-32">
      <div class="grid gap-8 md:grid-cols-12">
        <p data-reveal class="mono-label flex items-center gap-2 text-bone/80 md:col-span-4 md:pt-6">
          <span class="flex items-center gap-1.5"><span class="block h-2.5 w-2.5 bg-orange"></span><span class="block h-2.5 w-2.5 bg-blue"></span><span class="ml-1">05</span></span>
          {t.label}
        </p>
        <h2 class="display text-[clamp(3.5rem,11vw,10rem)] md:col-span-8" data-split>
          {t.title}<sup class="ml-2 align-super font-mono text-[0.16em] font-normal tracking-normal text-muted">({services.length})</sup>
        </h2>
      </div>

      <ul class="mt-16 md:mt-24" data-accordion>
        {
          services.map((s, i) => (
            <li data-reveal class="border-t border-white/15 last:border-b">
              <button
                type="button"
                class="acc-trigger group grid w-full grid-cols-12 items-center gap-4 py-6 text-left md:py-8"
                aria-expanded={i === 0 ? 'true' : 'false'}
                aria-controls={`service-${i}`}
              >
                <span class="mono-label col-span-2 text-muted md:col-span-4">({String(i + 1).padStart(3, '0')})</span>
                <span class="col-span-8 text-2xl font-semibold tracking-tight transition-colors group-hover:text-orange md:col-span-7 md:text-4xl">
                  {s.title[lang]}
                </span>
                <span class="acc-icon col-span-2 grid h-10 w-10 place-items-center justify-self-end rounded-full border border-white/20 transition-all duration-500 ease-expo group-hover:border-orange group-hover:bg-orange group-hover:text-ink md:col-span-1">
                  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                    <path d="M0 6h12" stroke="currentColor" stroke-width="1.5" />
                    <path class="acc-plus origin-center transition-transform duration-500" d="M6 0v12" stroke="currentColor" stroke-width="1.5" />
                  </svg>
                </span>
              </button>
              <div id={`service-${i}`} class="acc-panel overflow-hidden" style={i === 0 ? '' : 'height:0'} role="region">
                <div class="grid grid-cols-12 gap-4 pb-10 md:pb-12">
                  <div class="col-span-12 md:col-span-4 md:col-start-5">
                    <p class="text-[15px] leading-relaxed text-bone/70">{s.text[lang]}</p>
                  </div>
                  <div class="col-span-12 md:col-span-4">
                    <p class="mono-label mb-3 text-muted">{t.categories}</p>
                    <ul class="flex flex-wrap gap-2">
                      {s.categories.map((c) => (
                        <li class="rounded-full bg-bone px-3 py-1 text-xs font-medium text-ink">{c}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .acc-trigger[aria-expanded='true'] .acc-plus {
    transform: rotate(90deg);
  }
</style>

<script>
  import { gsap } from 'gsap';

  document.querySelectorAll<HTMLButtonElement>('[data-accordion] .acc-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const panel = document.getElementById(btn.getAttribute('aria-controls') || '');
      if (!panel) return;
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      gsap.to(panel, {
        height: open ? 0 : 'auto',
        duration: 0.7,
        ease: 'expo.out',
        onComplete: () => window.dispatchEvent(new Event('resize')),
      });
    });
  });
</script>
