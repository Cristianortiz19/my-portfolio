---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Contact from '../components/Contact.astro';
import LogoMark from '../components/LogoMark.astro';
import { projects } from '../data/projects';
import { ui, contact, localePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const p = t.projectsPage;
const filters = [
  { key: 'all', label: p.filters.all, count: projects.length },
  { key: 'web', label: p.filters.web, count: projects.filter((x) => x.kind === 'web').length },
  { key: 'mobile', label: p.filters.mobile, count: projects.filter((x) => x.kind === 'mobile').length },
  { key: 'system', label: p.filters.system, count: projects.filter((x) => x.kind === 'system').length },
];
---

<Layout lang={lang} title={t.meta.projectsTitle} description={t.meta.projectsDescription} path="/projects">
  <section class="wrap pt-32 md:pt-44">
    <a href={localePath(lang, '/')} data-reveal class="mono-label inline-flex items-center gap-2 text-muted hover:text-orange">
      ← {p.back}
    </a>

    <div class="mt-10 grid items-end gap-8 md:grid-cols-12">
      <h1 class="display text-[clamp(3.75rem,14vw,15rem)] md:col-span-12">
        <span class="hero-line block overflow-hidden" data-line-reveal
          ><span class="block"
            >{t.work.title}<sup class="ml-2 align-super font-mono text-[0.14em] font-normal tracking-normal text-orange"
              >({String(projects.length).padStart(2, '0')})</sup
            ></span
          ></span
        >
      </h1>
      <p data-reveal class="max-w-sm text-lg leading-relaxed text-bone/70 md:col-span-4 md:col-start-9">{p.intro}</p>
    </div>

    <!-- Filtros -->
    <div class="mt-12 flex flex-wrap gap-2 border-y border-line py-4" role="group" aria-label="Filter" data-reveal>
      {
        filters.map((f, i) => (
          <button
            type="button"
            data-filter={f.key}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="filter-btn rounded-full border border-line px-4 py-2 text-sm transition-colors hover:border-bone aria-pressed:border-bone aria-pressed:bg-bone aria-pressed:text-ink"
          >
            {f.label} <span class="ml-1 font-mono text-[11px] opacity-60">{f.count}</span>
          </button>
        ))
      }
    </div>

    <div id="project-grid" class="mt-14 grid gap-x-6 gap-y-16 md:grid-cols-2 md:gap-y-24">
      {projects.map((proj, i) => <ProjectCard project={proj} lang={lang} index={i} />)}
    </div>

    <!-- Más en Behance -->
    <a
      href={contact.behance}
      target="_blank"
      rel="noopener"
      data-reveal
      class="group mt-28 flex flex-col justify-between gap-8 rounded-3xl border border-line bg-coal-2 p-8 transition-colors hover:border-blue md:flex-row md:items-center md:p-12"
    >
      <div>
        <p class="mono-label text-muted">{p.moreText}</p>
        <p class="mt-3 display text-[clamp(2.5rem,6vw,5rem)]">
          {p.more.split(' ').slice(0, -1).join(' ')}{' '}<span class="font-serif font-normal text-blue-light italic">{p.more.split(' ').slice(-1)}</span>
        </p>
      </div>
      <span class="grid h-20 w-20 shrink-0 place-items-center rounded-full bg-blue text-bone transition-transform duration-700 ease-expo group-hover:rotate-[-45deg] md:h-28 md:w-28">
        <LogoMark class="h-6 w-auto md:h-8" />
      </span>
    </a>
  </section>

  <Contact lang={lang} />
</Layout>

<script>
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('#project-grid .project-card');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const key = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      cards.forEach((card) => {
        const show = key === 'all' || card.dataset.kind === key;
        card.style.display = show ? '' : 'none';
        if (show) {
          card.style.opacity = '1';
          card.style.transform = 'none';
        }
      });
      ScrollTrigger.refresh();
    }),
  );
</script>
